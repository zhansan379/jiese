# 复制为 .env 并按需修改；全部留空 = BM25 检索 + 原文摘录模式（无需任何 API Key）

# PostgreSQL（本地 Docker）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=jiese
PG_USER=postgres
PG_PASSWORD=postgres

# OpenAI 兼容端点（示例为智谱；也可用 OpenAI / DeepSeek 等）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
LLM_MODEL=glm-4-flash

# 向量检索（可选）：配置后构建期生成向量索引、查询期启用混合检索
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_WEIGHT=0.5
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 语料路径
EPUB_JWLY=D:\feng1\Documents\戒为良药 - 飞翔.epub
EPUB_JZL=D:\feng1\Documents\戒者录 - 前辈.epub
